# ============================================================================
# Google Cloud Agent Platform (Vertex AI) & Prosodia Configuration Placeholders
# ============================================================================
# 1. Copy this file to .env:
#      cp .env.example .env
#
# 2. Authenticate with Application Default Credentials (ADC) — NO service account
#    JSON key files needed:
#      gcloud auth application-default login
#
# 3. Replace <YOUR_GCP_PROJECT_ID> with your Google Cloud Project ID where the
#    Vertex AI API is enabled:
GOOGLE_CLOUD_PROJECT=<YOUR_GCP_PROJECT_ID>

# 4. Regional endpoint for Gemini 3.8 Live API WebSockets (e.g., us-central1, us, eu):
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_LIVE_LOCATION=us-central1

# 5. Local cache directory for HuggingFace checkpoints (alperiox/prosodia & whisper-small):
HF_HOME=/tmp/hf-cache
